SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_PROJECT_JWT_SECRET
REDIS_URL=redis://calls-redis:6379/0

# Comma-separated; used for CORS on dashboard origins.
CORS_ORIGINS=http://localhost:5173,https://calls.hdgelabs.com

# Bucket names — should match the migration.
RECORDINGS_BUCKET=call-recordings

# Billing (Polar). Set BILLING_MODE=live + product IDs to switch on real checkouts.
BILLING_MODE=mock
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_GROWTH=
POLAR_PRODUCT_BUSINESS=

DASHBOARD_URL=http://localhost:5173

LOG_LEVEL=info
